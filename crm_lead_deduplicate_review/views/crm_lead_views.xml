<odoo>
    <record id="action_deduplicate_group_leads" model="ir.actions.act_window">
        <field name="name">Duplicate Leads</field>
        <field name="res_model">deduplicate.group</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('res_model_name', '=', 'crm.lead')]</field>
        <field
            name="search_view_id"
            ref="base_deduplicate_review.view_deduplicate_group_search"
        />
        <field name="context">{'search_default_to_review': 1}</field>
    </record>
    <menuitem
        id="menu_deduplicate_leads"
        name="Duplicates"
        parent="crm.crm_menu_leads"
        action="action_deduplicate_group_leads"
        sequence="50"
        groups="base_deduplicate_review.group_deduplicate_reviewer"
    />
    <record id="action_review_selected_leads" model="ir.actions.server">
        <field name="name">Review as Duplicates</field>
        <field name="model_id" ref="crm.model_crm_lead" />
        <field name="binding_model_id" ref="crm.model_crm_lead" />
        <field name="binding_view_types">list,kanban</field>
        <field
            name="group_ids"
            eval="[(4, ref('base_deduplicate_review.group_deduplicate_reviewer'))]"
        />
        <field name="state">code</field>
        <field name="code">action = records._deduplicate_review_selection()</field>
    </record>
</odoo>
